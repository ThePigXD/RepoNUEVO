<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema Principal del Sistema - Versión Rediseñada por Carlos M. -->
    <style name="Base.Theme.SupaBaseAndroid" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:windowBackground">@color/bg_app</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
    </style>

    <style name="Theme.SupaBaseAndroid" parent="Base.Theme.SupaBaseAndroid" />

    <!-- Estilos personalizados de la interfaz -->
    <style name="CardMenu">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/stroke_color</item>
        <item name="cardBackgroundColor">@color/card_surface</item>
    </style>

    <style name="ChipPrecio">
        <item name="android:background">@color/secondary_light</item>
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>
